# Copy to .env.local and fill in. Never commit .env.local.

# ── Google Spreadsheet (the database) ──────────────────────────────────────
# The id is the long part of the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=
# A Google Cloud service account with the Sheets API enabled. Share the
# spreadsheet with this email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=tourism-desk@your-project.iam.gserviceaccount.com
# The service account's private key, on one line with \n for line breaks, in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of this CMS (used in email links and the Google sign-in redirect)
APP_URL=http://localhost:3000
# Signs session cookies. 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ── Optional: "Continue with Google" ───────────────────────────────────────
# OAuth client (Web application) from Google Cloud → APIs & Services → Credentials.
# Authorised redirect URI: <APP_URL>/auth/google/callback. Leave blank to hide the button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Email via AWS SES (invites, password resets, review notifications) ──────
# Leave blank in development: emails, including their links, are printed to the server log.
AWS_SES_REGION=
AWS_SES_FROM=
# AWS credentials come from the standard chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an IAM role).

# ── Image uploads ──────────────────────────────────────────────────────────
# With a bucket set, uploads go to S3. Without one, they are saved to UPLOAD_DIR
# on this server and served from /uploads/… (needs a persistent disk).
AWS_S3_BUCKET=
AWS_S3_REGION=
# Public base URL for the bucket (or a CloudFront domain in front of it)
AWS_S3_PUBLIC_URL=
UPLOAD_DIR=./data/uploads

# Origins allowed to call the public content API from the browser (comma-separated)
PUBLIC_SITE_ORIGINS=https://cebu-island-tourism.web.app,https://cebucitytourism.web.app,https://r7-tourism.web.app
